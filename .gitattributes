# Keep provenance-locked source and protocol bytes identical on every platform.
.gitattributes text eol=lf
*.py text eol=lf
*.md text eol=lf
*.cff text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
MANIFEST.in text eol=lf
LICENSE text eol=lf

